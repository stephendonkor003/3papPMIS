APP_NAME="3PAP PMIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=3pap_pmis
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

THREEPAP_CHECKER_BASE_URL=https://checker.3pap.africa/api/v1
THREEPAP_CHECKER_API_TOKEN=
THREEPAP_CHECKER_TIMEOUT=20

IP_GEO_ENABLED=false
ABSTRACT_IP_GEOLOCATION_KEY=
IPDATA_API_KEY=
IPINFO_TOKEN=

EXTERNAL_PROCUREMENT_SUBMISSIONS_PATH=
EXTERNAL_PROCUREMENT_IMPORT_DRY_RUN=true
LEGACY_SQL_PATH=

# External M&E data synchronization is disabled until exact HTTPS hosts are listed.
# Persisted local paths are confined to the dedicated import root below.
ME_DATA_SOURCE_REMOTE_ALLOWED_HOSTS=
ME_DATA_SOURCE_REMOTE_MAX_BYTES=10485760
ME_DATA_SOURCE_LOCAL_ROOT=

REQUIRE_LOGIN_OTP_LOCALLY=false

# Optional one-time bootstrap account provisioning. Leave passwords blank to
# generate unique temporary credentials during an interactive seeder run.
MASTER_ADMIN_EMAIL=admin@example.invalid
MASTER_ADMIN_BOOTSTRAP_PASSWORD=
MASTER_ADMIN_ALTERNATE_EMAIL=alternate-admin@example.invalid
MASTER_ADMIN_ALTERNATE_BOOTSTRAP_PASSWORD=
SECONDARY_SUPER_ADMIN_EMAIL=secondary-admin@example.invalid
SECONDARY_SUPER_ADMIN_NAME="Secondary Super Administrator"
SECONDARY_SUPER_ADMIN_BOOTSTRAP_PASSWORD=
WORLD_BANK_PARTNER_EMAIL=funding-partner@example.invalid
WORLD_BANK_PARTNER_BOOTSTRAP_PASSWORD=
CONSORTIUM_BOOTSTRAP_ACCESS_ACCOUNTS=false
